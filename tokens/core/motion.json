{
  "$description": "CORE / GLOBAL motion primitives. The Nockerl feel is physical, springy, choreographed (never pulsing/glowing). Durations and easings are ratified and emitted to all three platforms. Springs remain PROPOSED (physical params; platform mapping unratified) and are not yet emitted.",
  "motion": {
    "duration": {
      "instant": {
        "$type": "duration",
        "$value": "0ms"
      },
      "fast": {
        "$type": "duration",
        "$value": "120ms",
        "$description": "Hover/press state changes."
      },
      "base": {
        "$type": "duration",
        "$value": "200ms",
        "$description": "Standard transitions."
      },
      "slow": {
        "$type": "duration",
        "$value": "320ms",
        "$description": "Larger choreographed moves."
      },
      "sheet": {
        "$type": "duration",
        "$value": "400ms",
        "$description": "Bottom-sheet enter/exit."
      },
      "pulse": {
        "$type": "duration",
        "$value": "800ms",
        "$description": "Status-dot live pulse half-period: the one attention rhythm."
      }
    },
    "easing": {
      "standard": {
        "$type": "cubicBezier",
        "$value": [
          0.2,
          0,
          0,
          1
        ],
        "$description": "Default ease for most transitions."
      },
      "emphasized": {
        "$type": "cubicBezier",
        "$value": [
          0.05,
          0.7,
          0.1,
          1
        ],
        "$description": "Decelerate-heavy for entrances."
      },
      "exit": {
        "$type": "cubicBezier",
        "$value": [
          0.3,
          0,
          0.8,
          0.15
        ],
        "$description": "Accelerate for exits."
      }
    },
    "spring": {
      "$description": "Physical spring params (Compose Spring DampingRatio/Stiffness). Web approximates with the easing curves above.",
      "snappy": {
        "damping": {
          "$type": "number",
          "$value": 0.9
        },
        "stiffness": {
          "$type": "number",
          "$value": 400
        }
      },
      "gentle": {
        "damping": {
          "$type": "number",
          "$value": 1.0
        },
        "stiffness": {
          "$type": "number",
          "$value": 200
        }
      },
      "bouncy": {
        "damping": {
          "$type": "number",
          "$value": 0.65
        },
        "stiffness": {
          "$type": "number",
          "$value": 350
        }
      }
    }
  }
}
