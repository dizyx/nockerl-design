root = true

[*]
indent_size = 4
indent_style = space
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

[*.{kt,kts}]
# Allow PascalCase for @Composable functions (standard in Jetpack Compose)
ktlint_function_naming_ignore_when_annotated_with = Composable

# Disable no-consecutive-comments: KDoc followed by line comments is fine
ktlint_standard_no-consecutive-comments = disabled
