{
  "name": "@dizyx/nockerl-react",
  "version": "2.1.0",
  "description": "React components for the Nockerl design system: token-pure, with SSR-safe injected styles. Source of truth: dizyx/nockerl-design. Pair with @dizyx/nockerl-tokens for the CSS custom properties.",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dizyx/nockerl-design.git",
    "directory": "packages/react"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run clean && npm run build",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "typescript": "^6.0.3"
  }
}
