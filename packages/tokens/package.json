{
  "name": "@dizyx/nockerl-tokens",
  "version": "2.1.0",
  "description": "The canonical web build of the Nockerl design tokens. CSS custom properties plus a typed token map (tokens.json and TS), generated from the DTCG source. Source of truth: dizyx/nockerl-design.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dizyx/nockerl-design.git",
    "directory": "packages/tokens"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "prepublishOnly": "cd ../.. && bun run build"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tokens.json": "./dist/tokens.json",
    "./tokens.css": "./dist/tokens.css"
  },
  "sideEffects": [
    "*.css"
  ]
}
