{
  "name": "@dizyx/nockerl-design-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Astro Starlight documentation site for the Nockerl design framework. Self-contained, with its own package.json and node_modules, separate from the token build at the repo root.",
  "scripts": {
    "dev": "astro dev --host localhost --port 4321",
    "build:astro": "astro build --outDir dist-next",
    "build": "bun run build:astro && bun run scripts/swap-dist.mjs",
    "preview": "astro preview --host localhost --port 4321",
    "check": "astro check",
    "lint": "eslint ."
  },
  "dependencies": {
    "@astrojs/react": "^6.0.0",
    "@astrojs/starlight": "^0.41.1",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.0",
    "@codemirror/view": "^6.43.5",
    "@dizyx/nockerl-react": "workspace:*",
    "@dizyx/nockerl-tokens": "workspace:*",
    "@fontsource/outfit": "^5.2.8",
    "@fontsource/space-mono": "^5.2.9",
    "@lezer/highlight": "^1.2.3",
    "astro": "^7.0.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^9.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript-eslint/parser": "^8.62.0",
    "astro-eslint-parser": "^2.1.0",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^2.1.1",
    "prettier": "^3.8.0",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^6.0.3"
  }
}
