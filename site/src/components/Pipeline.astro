---
/**
 * Pipeline: how one token source becomes three platform outputs.
 *
 * This was an ASCII drawing inside a fenced code block, which read as source you
 * could copy and run rather than as a diagram. Rendered from tokens instead, so
 * it also inherits the theme rather than sitting there as monospace text.
 */
const STAGES = [
  {
    label: 'Source',
    items: ['tokens/*.json'],
    note: 'W3C DTCG, layered core to semantic',
  },
  {
    label: 'Build',
    items: ['Style Dictionary'],
    note: 'one build, three emitters',
  },
  {
    label: 'Outputs',
    items: ['CSS custom properties', 'Kotlin (Compose)', 'Swift (SwiftUI)'],
    note: 'generated, never hand-edited',
  },
  {
    label: 'Published',
    items: ['@dizyx/nockerl-tokens', 'com.dizyx.nockerl', 'NockerlDesign (SPM)'],
    note: 'one version line, semver',
  },
];
---

<div class="nk-pipe not-content" role="img" aria-label="Design tokens are built by Style Dictionary into web, Android and Swift outputs, then published as versioned packages on one version line.">
  <div class="nk-pipe__track">
    {STAGES.map((s, i) => (
      <>
        <div class="nk-pipe__stage">
          <span class="nk-pipe__label">{s.label}</span>
          <ul class="nk-pipe__items">
            {s.items.map((it) => <li>{it}</li>)}
          </ul>
          <span class="nk-pipe__note">{s.note}</span>
        </div>
        {i < STAGES.length - 1 && <div class="nk-pipe__arrow" aria-hidden="true"></div>}
      </>
    ))}
  </div>
</div>

<style>
  /* The stacked fallback has to answer "does the row fit the space this component was
     given", not "how wide is the window". In the docs shell those are nowhere near the
     same number: a sidebar on the left and the page outline on the right cap the content
     column at 45rem, so at a 1920px window the diagram is still handed only 720px and a
     viewport query reads a width it never actually gets. Containment makes the real figure
     queryable. The row itself sits one level in because a size container cannot be
     restyled by its own query, and the switch is a flex-direction change on the row. */
  .nk-pipe {
    container-type: inline-size;
    container-name: nk-pipe;
    margin: var(--space-6) 0;
  }
  .nk-pipe__track {
    display: flex;
    align-items: stretch;
    gap: 0;
    flex-wrap: wrap;
  }
  .nk-pipe__stage {
    flex: 1 1 12rem;
    min-width: 11rem;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border: var(--space-px) solid var(--color-card-hairline);
    border-radius: var(--radius-control);
    background: var(--color-canvas);
  }
  /* The stage caption is the system's uppercase eyebrow: size-10, eyebrow tracking,
     semibold. Same construction the specimen and the demos use. */
  .nk-pipe__label {
    font-size: var(--font-size-10);
    letter-spacing: var(--font-tracking-eyebrow);
    text-transform: uppercase;
    font-weight: var(--font-weight-semibold);
    color: var(--color-accent-primary);
  }
  .nk-pipe__items {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .nk-pipe__items li {
    font-family: var(--font-family-mono);
    font-size: var(--font-size-12);
    line-height: var(--font-line-height-16);
    color: var(--color-on-canvas);
  }
  .nk-pipe__note {
    font-size: var(--font-size-12);
    line-height: var(--font-line-height-16);
    color: var(--color-on-canvas-muted);
    margin-top: auto;
  }
  /* The connector between stages. A caret rather than a drawn line, so it stays
     crisp at any zoom and disappears cleanly when the stages wrap. */
  .nk-pipe__arrow {
    flex: 0 0 1.6rem;
    align-self: center;
    height: var(--space-px);
    background: var(--color-divider);
    position: relative;
  }
  /* The caret head is drawn geometry (a rotated corner), so its 7px box and -3px seat are
     literal on purpose: they centre the glyph on the 1px rule, and no spacing step lands
     on the half-pixel this needs. */
  .nk-pipe__arrow::after {
    content: '';
    position: absolute;
    right: 0;
    top: -3px;
    width: 7px;
    height: 7px;
    border-top: var(--space-px) solid var(--color-divider);
    border-right: var(--space-px) solid var(--color-divider);
    transform: rotate(45deg);
  }
  /* The threshold is the row's own arithmetic, not a guess. A flex line breaks on the
     items' basis rather than on the width they would shrink to, so the row needs four
     stages at their 12rem basis plus three 1.6rem connectors: 52.8rem. Sweeping the built
     page confirms it, holding one row at 845px and wrapping at 844, which is 52.8rem at a
     16px root. 53rem is the first round step clear of that, and staying in rem keeps the
     trigger locked to the basis it is derived from at any root size. */
  @container nk-pipe (max-width: 53rem) {
    .nk-pipe__track { flex-direction: column; }
    /* The 12rem basis is a COLUMN width. Once the track turns vertical the same number
       becomes a minimum HEIGHT, so every stage inflated to 192px and the note, which is
       pushed down by `margin-top: auto`, left a dead gap under short stages. Stacked is the
       only branch the docs shell ever reaches, so this is what the page actually shows: let
       each stage size to its own content instead. */
    .nk-pipe__stage { flex: 0 0 auto; }
    .nk-pipe__arrow {
      flex: 0 0 1.1rem;
      width: 1px;
      height: 1.1rem;
      align-self: center;
    }
    .nk-pipe__arrow::after { right: -3px; top: auto; bottom: 0; transform: rotate(135deg); }
  }
</style>
