---
/**
 * ComposeGraph.astro renders the GENERATED composition graph (build/compose census).
 *
 * The data is site/src/data/compose-graph.json, produced by `bun run compose:graph`
 * (scripts/compose-graph.ts) from the real `compose` contracts + JSX graph. This page
 * is the live, code-derived replacement for the old hand-maintained dependency map: it
 * never rots because the gate regenerates the JSON and (Phase 4) fails on any drift.
 */
import graph from '../data/compose-graph.json';

type Slot = { accepts: string[] | '*'; required?: boolean };
type Comp = {
  hierTier: string;
  tier: string | null;
  slots: Record<string, Slot> | null;
  owns: string[];
  hasContract: boolean;
  renders: string[];
  consumers: string[];
};
type Violation = { type: string; component: string; detail: string; file: string; line: number };

const g = graph as unknown as {
  counts: { components: number; withContract: number; leaf: number; optional: number; required: number; violations: number; byType: Record<string, number> };
  coverage: { opaqueSlotFills: number };
  components: Record<string, Comp>;
  violations: Violation[];
};

const comps = Object.entries(g.components).sort((a, b) => a[0].localeCompare(b[0]));
const slotStr = (slots: Record<string, Slot> | null): string =>
  !slots ? 'none' : Object.entries(slots).map(([n, s]) => `${n}: ${s.accepts === '*' ? '∗' : (s.accepts as string[]).join('/')}${s.required ? ' ✳' : ''}`).join(' · ');
const vByType = Object.entries(g.counts.byType).sort();
---

<div class="cg not-content">
  <div class="cg__cards">
    <div class="cg__card"><span class="cg__n">{g.counts.components}</span><span class="cg__l">components</span></div>
    <div class="cg__card"><span class="cg__n">{g.counts.withContract}</span><span class="cg__l">with a contract</span></div>
    <div class="cg__card"><span class="cg__n">{g.counts.leaf}·{g.counts.optional}·{g.counts.required}</span><span class="cg__l">leaf · optional · required</span></div>
    <div class={`cg__card ${g.counts.violations ? 'cg__card--warn' : 'cg__card--ok'}`}><span class="cg__n">{g.counts.violations}</span><span class="cg__l">violations</span></div>
  </div>

  <h2>Violations</h2>
  {vByType.length ? (
    <p class="cg__by">{vByType.map(([t, n]) => (<span class="cg__pill">{n} {t}</span>))}</p>
    <table class="cg__t">
      <thead><tr><th>Type</th><th>Component</th><th>Detail</th><th>Where</th></tr></thead>
      <tbody>
        {g.violations.map((v) => (
          <tr>
            <td><code>{v.type}</code></td>
            <td>{v.component}</td>
            <td>{v.detail}</td>
            <td class="cg__where">{v.file}:{v.line}</td>
          </tr>
        ))}
      </tbody>
    </table>
  ) : (<p>✓ No violations: every container composes real, approved children.</p>)}

  <h2>Composition map</h2>
  <p class="cg__note">Tier is derived from the contract (leaf / optional / required). <code>owns</code> = raw facsimile tags a component legitimately implements as its own primitive. Slots show <code>name: accepts</code> (<code>∗</code> = any design component, <code>✳</code> = required).</p>
  <table class="cg__t">
    <thead><tr><th>Component</th><th>Hier</th><th>Tier</th><th>Owns</th><th>Slots</th><th>Renders</th><th>Consumers</th></tr></thead>
    <tbody>
      {comps.map(([name, c]) => (
        <tr>
          <td><b>{name}</b></td>
          <td class="cg__dim">{c.hierTier}</td>
          <td>{c.tier ?? 'none'}</td>
          <td class="cg__dim">{c.owns.length ? c.owns.join(', ') : 'none'}</td>
          <td class="cg__dim">{slotStr(c.slots)}</td>
          <td class="cg__dim" title={c.renders.join(', ')}>{c.renders.length || 'none'}</td>
          <td class="cg__dim" title={c.consumers.join(', ')}>{c.consumers.length || 'none'}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  /* This subtree opts out of the docs prose cascade via `not-content` on the root, so it
     no longer inherits the 16px flow margin that was staggering `.cg__cards`. That cascade
     was also the ONLY thing spacing the headings, paragraphs and tables below, so their
     margins are declared here explicitly. Leaving them implicit is what made the opt-out
     look unsafe; owning them is what makes it safe. */
  .cg h2 { margin: var(--space-8) 0 var(--space-3); }
  .cg p { margin: 0 0 var(--space-3); }
  .cg .cg__t { margin: 0 0 var(--space-6); }

  .cg__cards { display: flex; flex-wrap: wrap; gap: var(--space-3); margin: var(--space-4) 0 var(--space-6); }
  .cg__card { display: flex; flex-direction: column; gap: var(--space-0-5); padding: var(--space-3) var(--space-4);
    border: var(--space-px) solid var(--color-card-hairline); border-radius: var(--radius-card);
    background: var(--color-card-surface1); min-width: 8rem; }
  .cg__card--warn { border-color: var(--color-status-warning); }
  .cg__card--ok { border-color: var(--color-status-success); }
  .cg__n { font-size: var(--font-size-24); font-weight: var(--font-weight-bold); line-height: 1; }
  .cg__l { font-size: var(--font-size-12); color: var(--color-on-card-muted); }
  .cg__by { display: flex; flex-wrap: wrap; gap: var(--space-1); }
  /* Counters, not chips, so they take the control radius. The full stadium is reserved. */
  .cg__pill { font-size: var(--font-size-12); padding: var(--space-0-5) var(--space-2); border-radius: var(--radius-control);
    background: var(--color-card-surface2); border: var(--space-px) solid var(--color-card-hairline); }
  .cg__t { display: table; width: 100%; font-size: var(--font-size-12); }
  .cg__t th, .cg__t td { text-align: left; vertical-align: top; padding: var(--space-1) var(--space-2); }
  .cg__where { font-family: var(--font-family-mono); font-size: var(--font-size-12); color: var(--color-on-card-muted); white-space: nowrap; }
  .cg__dim { color: var(--color-on-card-muted); }
  .cg__note { font-size: var(--font-size-12); color: var(--color-on-card-muted); }
</style>
