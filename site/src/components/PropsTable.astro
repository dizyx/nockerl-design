---
// PropsTable: renders a props/parameters array as a table.
// Each row: name (+ required marker), type, default, description.
//
// TWO modes:
//   1. `component="NockerlButton"`: CODE-DERIVED. Loads the rows from site/src/data/props.json
//      (generated by `bun run props:extract` from the REAL @dizyx/nockerl-react props
//      interfaces). Use this for the React / TypeScript tab so the table can NEVER drift
//      from the type; it IS the type. Mirrors how ComposeGraph.astro consumes
//      compose-graph.json.
//   2. `rows={[…]}`: hand-authored. For the Kotlin / Swift tabs (no TS source to derive
//      from) and any narrative table.
import propsData from '../data/props.json';

export interface PropRow {
  name: string;
  type: string;
  required?: boolean;
  default?: string;
  description: string;
}

interface ExtractedProp {
  name: string;
  type: string;
  optional: boolean;
  default: string | null;
  description: string;
}
interface ExtractedComponent {
  file: string;
  propsType: string;
  extendsClause: string | null;
  props: ExtractedProp[];
}

interface Props {
  /** Explicit, hand-authored rows (Kotlin / Swift tabs). Mutually exclusive with `component`. */
  rows?: PropRow[];
  /** Component name to load CODE-DERIVED rows for from props.json (the React/TS tab). */
  component?: string;
  /** Column header for the name column (e.g. "Prop" for web, "Parameter" for Compose). */
  nameLabel?: string;
}

const { rows: explicitRows, component, nameLabel = 'Prop' } = Astro.props;

const catalog = (propsData as { components: Record<string, ExtractedComponent> }).components;

// Resolve the derived component (if any) up front so we can fail LOUDLY at build time
// when a page references a name the extractor did not produce. A broken reference must
// never render an empty table silently.
const derived = component ? catalog[component] : undefined;
if (component && !derived) {
  throw new Error(
    `<PropsTable component="${component}" />: no such component in site/src/data/props.json. ` +
      `Run \`bun run props:extract\`. Known: ${Object.keys(catalog).join(', ')}`,
  );
}

// Map the extractor shape → PropRow (optional → required inverse; null default → undefined).
const derivedRows: PropRow[] = derived
  ? derived.props.map((p) => ({
      name: p.name,
      type: p.type,
      required: !p.optional,
      ...(p.default != null ? { default: p.default } : {}),
      description: p.description,
    }))
  : [];

const rows: PropRow[] = derived ? derivedRows : (explicitRows ?? []);

// For the derived tab, surface the inherited native-element passthrough (onClick, disabled,
// aria-*, …) as a footnote so readers know those props exist without hand-listing them.
function nativeElementNote(clause: string | null): string | null {
  if (!clause) return null;
  const m = clause.match(/(Anchor|Button|Input|Textarea|SVG|Option|AllHTML|HTML)Attributes<\s*(HTML|SVG)([A-Za-z]+)Element\s*>/);
  if (!m) return null;
  const el = m[3]!.replace(/Element$/, '');
  const tag =
    { Button: 'button', Anchor: 'a', Input: 'input', TextArea: 'textarea', OList: 'ol', Div: 'div', Span: 'span', HR: 'hr', SVGSVG: 'svg' }[
      el
    ] ?? el.toLowerCase();
  return tag;
}
const nativeTag = derived ? nativeElementNote(derived.extendsClause) : null;
---

<div class="nk-props">
  <table>
    <thead>
      <tr>
        <th>{nameLabel}</th>
        <th>Type</th>
        <th>Default</th>
        <th>Description</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr>
            <td>
              <code class="nk-props__name">{row.name}</code>
              {row.required && (
                <span class="nk-props__required" title="Required">
                  {' '}*
                </span>
              )}
            </td>
            <td>
              <code>{row.type}</code>
            </td>
            <td>{row.default ? <code>{row.default}</code> : <span aria-hidden="true">n/a</span>}</td>
            <td set:html={row.description} />
          </tr>
        ))
      }
    </tbody>
  </table>
  {
    nativeTag && (
      <p class="nk-props__note">
        Also accepts the native <code>&lt;{nativeTag}&gt;</code> attributes (e.g. <code>onClick</code>,{' '}
        <code>disabled</code>, <code>id</code>, <code>aria-*</code>, <code>data-*</code>), forwarded straight through, plus a
        forwarded <code>ref</code>.
      </p>
    )
  }
</div>

<style>
  .nk-props__note {
    font-size: 0.8rem;
    color: var(--sl-color-gray-3);
    margin-top: 0.5rem;
  }
</style>
